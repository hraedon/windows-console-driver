<configuration><configSections><sectionGroup name="system.webServer">
<sectionGroup name="security"><section name="access" overrideModeDefault="Deny"/>
<sectionGroup name="authentication">
<section name="windowsAuthentication" overrideModeDefault="Deny"/>
</sectionGroup></sectionGroup></sectionGroup></configSections>
<location path="Synthetic Site/Enrollment"><system.webServer><security>
<access sslFlags="Ssl, Ssl128"/><authentication><windowsAuthentication enabled="true">
<providers><clear/><add value="Negotiate"/><add value="NTLM"/></providers>
<extendedProtection tokenChecking="Require"/></windowsAuthentication></authentication>
</security></system.webServer></location></configuration>