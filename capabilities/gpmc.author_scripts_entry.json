{
  "$schema": "docs/capability-schema-v0.json",
  "id": "gpmc.author_scripts_entry",
  "surface": "gpmc-server2025",
  "revision": 2,
  "intent": "Author exactly two command startup entries and one PowerShell startup entry on a disposable GPO via the GPMC Scripts editor, preserving their distinctive names, parameters, and order so the exact scripts.ini and psscripts.ini representation can be independently certified.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "gpo_name",
      "domain_dns",
      "script1_name",
      "script1_params",
      "script2_name",
      "ps1_name",
      "ps1_params"
    ],
    "properties": {
      "gpo_name": { "type": "string" },
      "domain_dns": { "type": "string" },
      "script1_name": { "type": "string" },
      "script1_params": { "type": "string" },
      "script2_name": { "type": "string" },
      "ps1_name": { "type": "string" },
      "ps1_params": { "type": "string" }
    }
  },
  "channel_contract": {
    "setup": [
      "powershell"
    ],
    "operation_under_test": [
      "gpmc_ui"
    ],
    "orientation": [
      "uia",
      "hwnd",
      "screenshot"
    ],
    "input_delivery": [
      "helper_input",
      "hyperv_input"
    ],
    "oracle": [
      "gpo_observers"
    ],
    "cleanup": [
      "powershell",
      "programmatic_requery"
    ]
  },
  "first_commit_point": "ok_child_dialog",
  "run_sheet": "gpmc.author_scripts_entry",
  "gpo_transaction": true,
  "fact_plan": {
    "observers": [
      {
        "name": "r2_core",
        "params": {}
      }
    ]
  },
  "envelope": {
    "require": [
      {
        "fact": "scripts_ini.machine",
        "predicate": "post.scripts_ini.machine.present == True"
      },
      {
        "fact": "scripts_ini.machine.config_shape",
        "predicate": "post.scripts_ini.machine.config_shape == 'none'"
      },
      {
        "fact": "scripts_ini.machine.Startup.0.script",
        "predicate": "post['scripts_ini.machine.Startup.0.script'] == args['script1_name']"
      },
      {
        "fact": "scripts_ini.machine.Startup.entry_count",
        "predicate": "post.scripts_ini.machine.Startup.entry_count == 2"
      },
      {
        "fact": "scripts_ini.machine.Startup.0.parameters",
        "predicate": "post['scripts_ini.machine.Startup.0.parameters'] == args['script1_params']"
      },
      {
        "fact": "scripts_ini.machine.Startup.1.script",
        "predicate": "post['scripts_ini.machine.Startup.1.script'] == args['script2_name']"
      },
      {
        "fact": "scripts_ini.machine.Startup.1.parameters",
        "predicate": "post['scripts_ini.machine.Startup.1.parameters'] == ''"
      },
      {
        "fact": "scripts_ini.ps.machine",
        "predicate": "post.scripts_ini.ps.machine.present == True"
      },
      {
        "fact": "scripts_ini.ps.machine.Startup.0.script",
        "predicate": "post['scripts_ini.ps.machine.Startup.0.script'] == args['ps1_name']"
      },
      {
        "fact": "scripts_ini.ps.machine.Startup.entry_count",
        "predicate": "post.scripts_ini.ps.machine.Startup.entry_count == 1"
      },
      {
        "fact": "scripts_ini.ps.machine.Startup.0.parameters",
        "predicate": "post['scripts_ini.ps.machine.Startup.0.parameters'] == args['ps1_params']"
      },
      {
        "fact": "scripts_ini.ps.machine.config_shape",
        "predicate": "post.scripts_ini.ps.machine.config_shape == 'none'"
      },
      {
        "fact": "ad.gPCMachineExtensionNames",
        "predicate": "'{42B5FAAE-6536-11D2-AE5A-0000F87571E3}' in post.ad.gPCMachineExtensionNames and '{40B6664F-4972-11D1-A7CA-0000F87571E3}' in post.ad.gPCMachineExtensionNames"
      }
    ],
    "allow": [
      {
        "category": "timestamps"
      },
      {
        "category": "replication_metadata"
      },
      {
        "category": "file_mtime"
      }
    ],
    "forbid": [
      {
        "scope": "ad.gPCMachineExtensionNames",
        "predicate": "'3125E937-EB16-4b4c-9934-544FC6D24D26' not in scope and 'A3CC7818-8A30-4e0c-91C5-A4EA4B5A8DAB' not in scope"
      },
      {
        "scope": "scope.sysvol_contained",
        "predicate": "scope == True"
      },
      {
        "scope": "scope.policies.gpc_guids",
        "predicate": "scope == pre.scope.policies.gpc_guids"
      }
    ],
    "derive": [
      {
        "relation": "post.version.machine == pre.version.machine + 1"
      },
      {
        "relation": "post.version.user == pre.version.user"
      },
      {
        "relation": "post.version.ad_versionNumber == pre.version.ad_versionNumber + 1"
      },
      {
        "relation": "post.version.raw != pre.version.raw"
      },
      {
        "relation": "post.scope.extension_lists.machine != pre.scope.extension_lists.machine"
      },
      {
        "relation": "post.scope.sysvol_relpaths != pre.scope.sysvol_relpaths"
      },
      {
        "relation": "post.ad.versionNumber == pre.ad.versionNumber + 1"
      }
    ],
    "convergence": {
      "window_seconds": 90,
      "poll_seconds": 5,
      "reproduce": 2
    }
  },
  "structured_checks": [
    {
      "id": "startup_entries_match_parameters",
      "checks": "The envelope requires exactly two scripts.ini Startup entries, with each name, parameter string, and authored position matched against the flat capability arguments. The entry count rejects extras."
    },
    {
      "id": "ps_entries_match_parameters",
      "checks": "The envelope requires exactly one psscripts.ini Startup entry with its name and parameters matched against the capability arguments."
    },
    {
      "id": "default_ps_order_shape_recorded",
      "checks": "This capability does not actuate the PowerShell-order dropdown; the envelope therefore requires the default psscripts config shape with no ScriptsConfig or Policy section. The dedicated ps-order capability certifies the non-default selection."
    },
    {
      "id": "sysvol_paths_contained",
      "checks": "Every relative path in post.scope.sysvol_relpaths stays under this GPO's GUID directory. Backs the sysvol_contained fact the declarative forbid consumes; computed by the observer, asserted here."
    }
  ],
  "bindings": {
    "args": "Capability arguments are flat and shared by the run-sheet placeholders and envelope predicates; the executor substitutes args['...'] references as JSON literals before evaluation.",
    "fact_vocabulary": "Fact keys reference gpo_observers' declared scheme (gpo_identity.*, ad.*, version.*, scripts_ini.*, sysvol.*, scope.*). Forbid clauses receive `scope` bound to the named fact's value and `scope_key` to its name, per wcd.envelope._build_bindings."
  },
  "cleanup": {
    "strategy": "remove_gpo",
    "requery": "strict_absence",
    "residual_accounting": true
  },
  "recovery": {
    "kind": "checkpoint_revert",
    "demonstration": "estate baseline checkpoint existence asserted at prepare"
  }
}
