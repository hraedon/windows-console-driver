{
  "$schema": "docs/capability-schema-v0.json",
  "id": "gpmc.author_scripts_entry",
  "surface": "gpmc-server2025",
  "revision": 1,
  "intent": "Author startup script entries on a disposable GPO via the GPMC Scripts (Startup/Startup) editor, with deliberately distinctive values, so that what Windows actually writes to scripts.ini and psscripts.ini can be independently observed.",
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "startup_cmd",
      "startup_ps1",
      "ps_order"
    ],
    "properties": {
      "startup_cmd": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "script",
            "parameters"
          ],
          "properties": {
            "script": {
              "type": "string"
            },
            "parameters": {
              "type": "string"
            }
          }
        }
      },
      "startup_ps1": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "script",
            "parameters"
          ],
          "properties": {
            "script": {
              "type": "string"
            },
            "parameters": {
              "type": "string"
            }
          }
        }
      },
      "ps_order": {
        "type": "string",
        "enum": [
          "default",
          "powershell_first"
        ]
      }
    }
  },
  "channel_contract": {
    "setup": [
      "powershell"
    ],
    "operation_under_test": [
      "gpmc_ui"
    ],
    "orientation": [
      "uia",
      "hwnd",
      "screenshot"
    ],
    "input_delivery": [
      "helper_input",
      "hyperv_input"
    ],
    "oracle": [
      "gpo_observers"
    ],
    "cleanup": [
      "powershell"
    ]
  },
  "first_commit_point": "startup-scripts-dialog-ok",
  "run_sheet": "gpmc.author_scripts_entry",
  "gpo_transaction": true,
  "fact_plan": {
    "observers": [
      {
        "name": "r2_core",
        "params": {}
      }
    ]
  },
  "envelope": {
    "require": [
      {
        "fact": "scripts_ini.machine",
        "predicate": "post.scripts_ini.machine.present == True"
      },
      {
        "fact": "scripts_ini.machine.config_shape",
        "predicate": "post.scripts_ini.machine.config_shape == 'none'"
      },
      {
        "fact": "scripts_ini.machine.Startup.0.script",
        "predicate": "post['scripts_ini.machine.Startup.0.script'] == args['startup_cmd.0.script']"
      },
      {
        "fact": "scripts_ini.ps.machine",
        "predicate": "post.scripts_ini.ps.machine.present == True"
      },
      {
        "fact": "ad.gPCMachineExtensionNames",
        "predicate": "'{42B5FAAE-6536-11D2-AE5A-0000F87571E3}' in post.ad.gPCMachineExtensionNames and '{40B6664F-4972-11D1-A7CA-0000F87571E3}' in post.ad.gPCMachineExtensionNames"
      }
    ],
    "allow": [
      {
        "category": "timestamps"
      },
      {
        "category": "replication_metadata"
      },
      {
        "category": "file_mtime"
      }
    ],
    "forbid": [
      {
        "scope": "ad.gPCMachineExtensionNames",
        "predicate": "'3125E937-EB16-4b4c-9934-544FC6D24D26' not in scope and 'A3CC7818-8A30-4e0c-91C5-A4EA4B5A8DAB' not in scope"
      },
      {
        "scope": "scope.sysvol_contained",
        "predicate": "scope == True"
      },
      {
        "scope": "scope.policies.gpc_guids",
        "predicate": "scope == pre.scope.policies.gpc_guids"
      }
    ],
    "derive": [
      {
        "relation": "post.version.machine == pre.version.machine + 1"
      },
      {
        "relation": "post.version.user == pre.version.user"
      },
      {
        "relation": "post.version.ad_versionNumber == pre.version.ad_versionNumber + 1"
      },
      {
        "relation": "post.version.raw != pre.version.raw"
      },
      {
        "relation": "post.scope.extension_lists.machine != pre.scope.extension_lists.machine"
      },
      {
        "relation": "post.scope.sysvol_relpaths != pre.scope.sysvol_relpaths"
      },
      {
        "relation": "post.ad.versionNumber == pre.ad.versionNumber + 1"
      }
    ],
    "convergence": {
      "window_seconds": 90,
      "poll_seconds": 5,
      "reproduce": 2
    }
  },
  "structured_checks": [
    {
      "id": "startup_entries_match_parameters",
      "checks": "The post-state scripts.ini machine Startup section carries exactly the parameterized entries from args.startup_cmd (script, parameters, authored order, no extras). Beyond the bounded evaluator: list-valued comparison implemented in the assertion layer."
    },
    {
      "id": "ps_entries_match_parameters",
      "checks": "The psscripts.ini machine Startup section carries exactly the entries from args.startup_ps1."
    },
    {
      "id": "ps_order_recorded",
      "checks": "The psscripts config shape records the ps_order setting: powershell_first maps to the StartExecutePSFirst/EndExecutePSFirst keys, default to their absence \u2014 whichever shape Windows actually writes is itself an R2 answer, so this check asserts the recorded value equals the authored intent after normalization, not a pre-chosen key name."
    },
    {
      "id": "sysvol_paths_contained",
      "checks": "Every relative path in post.scope.sysvol_relpaths stays under this GPO's GUID directory. Backs the sysvol_contained fact the declarative forbid consumes; computed by the observer, asserted here."
    }
  ],
  "bindings": {
    "args": "Capability arguments are bound into predicates under the `args` namespace; the runtime flattens the parameter tree into dotted-index keys (args['startup_cmd.0.script']). The envelope engine itself is namespace-agnostic; merging args is transaction-executor work.",
    "fact_vocabulary": "Fact keys reference gpo_observers' declared scheme (gpo_identity.*, ad.*, version.*, scripts_ini.*, sysvol.*, scope.*). Forbid clauses receive `scope` bound to the named fact's value and `scope_key` to its name, per wcd.envelope._build_bindings."
  },
  "cleanup": {
    "strategy": "remove_gpo",
    "requery": "strict_absence",
    "residual_accounting": true
  },
  "recovery": {
    "kind": "checkpoint_revert",
    "demonstration": "estate baseline checkpoint existence asserted at prepare"
  }
}
