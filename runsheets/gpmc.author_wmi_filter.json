{
  "name": "gpmc.author_wmi_filter",
  "surface": "gpmc-server2025",
  "steps": [
    {
      "action": "guest",
      "phase": "setup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpmc_launch"
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_gpmc_console",
      "title_regex": "Group Policy Management",
      "timeout_ms": 90000
    },
    {
      "action": "context",
      "profile_action": "navigate_tree",
      "assert_window_regex": "Group Policy Management"
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Forest:",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Domains$",
      "control_type": "ListItem",
      "double": true,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "{args.domain_dns}",
      "control_type": "ListItem",
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^WMI Filters$",
      "control_type": "ListItem",
      "settle_ms": 2000
    },
    {
      "action": "key",
      "profile_action": "open_new_wmi_filter_dialog",
      "vks": [
        {
          "vk": 65,
          "modifiers": ["alt"]
        }
      ]
    },
    {
      "action": "click_element",
      "profile_action": "open_new_wmi_filter_dialog",
      "name_regex": "^New",
      "control_type": "MenuItem",
      "soft": true,
      "settle_ms": 1000
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_new_wmi_filter_dialog",
      "title_regex": "New WMI Filter",
      "timeout_ms": 30000
    },
    {
      "action": "type_text",
      "profile_action": "open_new_wmi_filter_dialog",
      "text": "{args.filter_name}"
    },
    {
      "action": "key",
      "profile_action": "open_new_wmi_filter_dialog",
      "vks": [
        {
          "vk": 9,
          "modifiers": []
        }
      ]
    },
    {
      "action": "type_text",
      "profile_action": "open_new_wmi_filter_dialog",
      "text": "{args.filter_description}"
    },
    {
      "action": "click_element",
      "profile_action": "add_wmi_query",
      "name_regex": "^Add"
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_wmi_query",
      "title_regex": "WMI Query",
      "timeout_ms": 20000
    },
    {
      "action": "type_text",
      "profile_action": "add_wmi_query",
      "text": "{args.wmi_query}"
    },
    {
      "action": "click_element",
      "profile_action": "ok_wmi_query_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "click_element",
      "profile_action": "ok_new_wmi_filter_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "wmi_filter_remove",
      "args": [
        "{args.filter_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPMC"
      ]
    }
  ]
}
