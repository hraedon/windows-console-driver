{
  "name": "gpmc.author_wmi_filter",
  "surface": "gpmc-server2025",
  "steps": [
    {
      "action": "guest",
      "phase": "setup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpmc_launch"
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_gpmc_console",
      "title_regex": "Group Policy Management",
      "timeout_ms": 90000
    },
    {
      "action": "context",
      "profile_action": "navigate_tree",
      "assert_window_regex": "Group Policy Management"
    },
    {
      "action": "shot",
      "name": "w7-gpmc-open"
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "Console Embedded Scope",
      "control_type": "Tree",
      "settle_ms": 500
    },
    {
      "action": "key",
      "profile_action": "navigate_tree",
      "vks": [
        { "vk": 36, "modifiers": [] },
        { "vk": 40, "modifiers": [] },
        { "vk": 39, "modifiers": [] },
        { "vk": 40, "modifiers": [] },
        { "vk": 39, "modifiers": [] },
        { "vk": 40, "modifiers": [] },
        { "vk": 39, "modifiers": [] },
        { "vk": 87, "modifiers": [] }
      ]
    },
    {
      "action": "shot",
      "name": "w7-wmi-node"
    },
    {
      "action": "key",
      "profile_action": "open_new_wmi_filter_dialog",
      "vks": [
        { "vk": 121, "modifiers": ["shift"] },
        { "vk": 40, "modifiers": [] },
        { "vk": 13, "modifiers": [] }
      ]
    },
    {
      "action": "shot",
      "name": "w7-menu-opened"
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_new_wmi_filter_dialog",
      "title_regex": "New WMI Filter",
      "timeout_ms": 30000
    },
    {
      "action": "shot",
      "name": "w7-new-filter-dialog"
    },
    {
      "action": "type_text",
      "profile_action": "open_new_wmi_filter_dialog",
      "text": "{args.filter_name}"
    },
    {
      "action": "key",
      "profile_action": "open_new_wmi_filter_dialog",
      "vks": [
        {
          "vk": 9,
          "modifiers": []
        }
      ]
    },
    {
      "action": "type_text",
      "profile_action": "open_new_wmi_filter_dialog",
      "text": "{args.filter_description}"
    },
    {
      "action": "click_element",
      "profile_action": "add_wmi_query",
      "name_regex": "^Add"
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_wmi_query",
      "title_regex": "WMI Query",
      "timeout_ms": 20000
    },
    {
      "action": "shot",
      "name": "w7-query-dialog"
    },
    {
      "action": "type_text",
      "profile_action": "add_wmi_query",
      "text": "{args.wmi_query}"
    },
    {
      "action": "shot",
      "name": "w7-query-typed"
    },
    {
      "action": "click_element",
      "profile_action": "ok_wmi_query_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "click_element",
      "profile_action": "ok_new_wmi_filter_dialog",
      "name_regex": "^Save$"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "wmi_filter_remove",
      "args": [
        "{args.filter_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPMC"
      ]
    }
  ]
}
