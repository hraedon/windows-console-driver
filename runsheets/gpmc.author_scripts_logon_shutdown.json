{
  "name": "gpmc.author_scripts_logon_shutdown",
  "surface": "gpmc-server2025",
  "steps": [
    {
      "action": "guest",
      "phase": "setup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpo_create",
      "args": [
        "{args.gpo_name}",
        "Plan 035 WP-1 logon/shutdown scripts through the wcd engine"
      ],
      "output_as": "setup.gpo"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpme_launch",
      "args": [
        "{out.setup.gpo.guid}",
        "{args.domain_dns}"
      ]
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_gpo_editor",
      "title_regex": "Group Policy",
      "timeout_ms": 90000
    },
    {
      "action": "context",
      "profile_action": "navigate_tree",
      "assert_window_regex": "Group Policy"
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Computer Configuration$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Policies$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000,
      "soft": true
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Windows Settings$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "Scripts \\(Startup/Shutdown\\)",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "shot",
      "profile_action": "navigate_tree",
      "name": "wp1-machine-scripts-node"
    },
    {
      "action": "click_element",
      "profile_action": "open_shutdown_scripts_dialog",
      "name_regex": "^Shutdown$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_shutdown_scripts_dialog",
      "title_regex": "Shutdown Properties",
      "timeout_ms": 30000
    },
    {
      "action": "click_element",
      "profile_action": "open_shutdown_scripts_dialog",
      "name_regex": "^Scripts$",
      "index": 0,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "add_script_entry",
      "name_regex": "^Add",
      "index": 0
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_script_entry",
      "title_regex": "Add a Script",
      "timeout_ms": 20000
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.shutdown_script}"
    },
    {
      "action": "key",
      "profile_action": "add_script_entry",
      "vks": [
        {
          "vk": 9,
          "modifiers": []
        }
      ]
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.shutdown_params}"
    },
    {
      "action": "click_element",
      "profile_action": "ok_child_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "shot",
      "profile_action": "add_script_entry",
      "name": "wp1-shutdown-entry-added"
    },
    {
      "action": "click_element",
      "profile_action": "ok_shutdown_scripts_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "keys",
      "profile_action": "navigate_scope_root",
      "steps": [
        {
          "click_element": {
            "name_regex": "^Console Embedded Scope$",
            "control_type": "Tree",
            "offset_y": -201
          }
        },
        {
          "vks": [
            {
              "vk": 27,
              "modifiers": []
            }
          ]
        },
        {
          "vks": [
            {
              "vk": 36,
              "modifiers": []
            }
          ]
        }
      ],
      "delay_ms": 600,
      "label": "click the GPO root row of the UIA-invisible scope tree (offset measured from the tree's rect: the root is its first row), Escape any label edit, Home: lands on the root whichever node the click hit"
    },
    {
      "action": "wait_element",
      "profile_action": "navigate_scope_root",
      "name_regex": "^User Configuration$",
      "control_type": "ListItem",
      "timeout_ms": 60000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^User Configuration$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Policies$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000,
      "soft": true
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Windows Settings$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "Scripts \\(Logon/Logoff\\)",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "shot",
      "profile_action": "navigate_tree",
      "name": "wp1-user-scripts-node"
    },
    {
      "action": "click_element",
      "profile_action": "open_logon_scripts_dialog",
      "name_regex": "^Logon$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_logon_scripts_dialog",
      "title_regex": "Logon Properties",
      "timeout_ms": 30000
    },
    {
      "action": "click_element",
      "profile_action": "open_logon_scripts_dialog",
      "name_regex": "^Scripts$",
      "index": 0,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "add_script_entry",
      "name_regex": "^Add",
      "index": 0
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_script_entry",
      "title_regex": "Add a Script",
      "timeout_ms": 20000
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.logon_script}"
    },
    {
      "action": "key",
      "profile_action": "add_script_entry",
      "vks": [
        {
          "vk": 9,
          "modifiers": []
        }
      ]
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.logon_params}"
    },
    {
      "action": "click_element",
      "profile_action": "ok_child_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "shot",
      "profile_action": "add_script_entry",
      "name": "wp1-logon-entry-added"
    },
    {
      "action": "click_element",
      "profile_action": "ok_logon_scripts_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_backup_owned",
      "args": [
        "{out.setup.gpo.guid}",
        "{args.backup_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_remove_owned",
      "args": [
        "{out.setup.gpo.guid}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPME"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "zz_requery"
    }
  ]
}
