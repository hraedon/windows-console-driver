{
  "name": "gpmc.author_folder_redirection",
  "surface": "gpmc-server2025",
  "steps": [
    {
      "action": "guest",
      "phase": "setup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpo_create",
      "args": [
        "{args.gpo_name}",
        "R3: folder redirection via wcd"
      ],
      "output_as": "setup.gpo"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpme_launch",
      "args": [
        "{out.setup.gpo.guid}",
        "{args.domain_dns}"
      ]
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_gpo_editor",
      "title_regex": "Group Policy",
      "timeout_ms": 90000
    },
    {
      "action": "context",
      "profile_action": "navigate_tree",
      "assert_window_regex": "Group Policy"
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^User Configuration$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Policies$",
      "control_type": "ListItem",
      "double": true,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Windows Settings$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Folder Redirection$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Documents$",
      "control_type": "ListItem",
      "index": 0,
      "settle_ms": 1500
    },
    {
      "action": "keys",
      "profile_action": "open_property_dialog",
      "steps": [
        {
          "vks": [
            {
              "vk": 65,
              "modifiers": [
                "alt"
              ]
            }
          ]
        },
        {
          "vks": [
            {
              "vk": 13,
              "modifiers": []
            }
          ]
        }
      ],
      "delay_ms": 600,
      "label": "Alt+A -> ENTER (Open = Documents Properties)"
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_property_dialog",
      "title_regex": "Documents Properties",
      "timeout_ms": 30000
    },
    {
      "action": "dump",
      "label": "properties dialog before Setting change"
    },
    {
      "action": "keys",
      "profile_action": "interact_dialog_control",
      "steps": [
        {
          "click_element": {
            "name_regex": "^Not configured$"
          }
        },
        {
          "vks": [
            {
              "vk": 66,
              "modifiers": []
            }
          ]
        }
      ],
      "delay_ms": 400,
      "label": "Setting combo: click-focus + 'b' type-ahead (closed-combo first-letter select; one invocation so the keystroke lands while the combo holds focus -- the R3 DOWN variant never changed the selection)"
    },
    {
      "action": "dump",
      "label": "properties dialog after Basic (qualification checkpoint: Setting must read Basic)"
    },
    {
      "action": "shot",
      "name": "r3-setting-basic"
    },
    {
      "action": "keys",
      "profile_action": "interact_dialog_control",
      "steps": [
        {
          "click_element": {
            "name_regex": "^Root Path:",
            "offset_x": 0,
            "offset_y": 16
          }
        },
        {
          "text": "{args.root_path}"
        }
      ],
      "delay_ms": 400,
      "label": "Root Path: click-focus + type in one invocation (dialog focus resets across helper invocations)"
    },
    {
      "action": "shot",
      "name": "r3-root-path-typed"
    },
    {
      "action": "keys",
      "profile_action": "interact_dialog_control",
      "steps": [
        {
          "vks": [
            {
              "vk": 9,
              "modifiers": [
                "ctrl"
              ]
            }
          ]
        }
      ],
      "delay_ms": 400,
      "label": "Ctrl+Tab -> Settings tab"
    },
    {
      "action": "click_element",
      "profile_action": "interact_dialog_control",
      "name_regex": "Grant the user exclusive rights",
      "settle_ms": 400
    },
    {
      "action": "click_element",
      "profile_action": "interact_dialog_control",
      "name_regex": "Redirect the folder back to the local userprofile",
      "settle_ms": 400
    },
    {
      "action": "shot",
      "name": "r3-settings-selected"
    },
    {
      "action": "click_element",
      "profile_action": "ok_folder_redirect_dialog",
      "name_regex": "^OK$",
      "settle_ms": 2000
    },
    {
      "action": "dump",
      "label": "surface immediately after properties OK (qualification checkpoint)"
    },
    {
      "action": "shot",
      "name": "r3-post-ok-surface"
    },
    {
      "action": "click_element",
      "profile_action": "ok_child_dialog",
      "name_regex": "^Yes$",
      "settle_ms": 2000
    },
    {
      "action": "dump",
      "label": "surface immediately after Folder Redirection warning acceptance"
    },
    {
      "action": "shot",
      "name": "r3-post-warning-surface"
    },
    {
      "action": "key",
      "profile_action": "close_editor_window",
      "vks": [
        {
          "vk": 115,
          "modifiers": [
            "alt"
          ]
        }
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_backup",
      "args": [
        "{args.gpo_name}",
        "C:\\gpo-studio\\manual\\r03-folderredir\\backup"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_remove",
      "args": [
        "{args.gpo_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPME"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "zz_requery"
    }
  ]
}
