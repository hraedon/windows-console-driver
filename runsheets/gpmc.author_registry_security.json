            }
          ]
        }
      ],
      "delay_ms": 600,
      "label": "Alt+A -> DOWN -> ENTER (Add Key)"
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_property_dialog",
      "title_regex": "Select Registry Key",
      "timeout_ms": 30000
    },
    {
      "action": "dump",
      "label": "select dialog after combo click"
    },
    {
      "action": "shot",
      "name": "r4-bravo-select-dialog"
    },
    {
      "action": "keys",
      "profile_action": "interact_dialog_control",
      "steps": [
        {
          "click_element": {
            "name_regex": "^(Selected key:|Folder:)",
            "offset_x": 0,
            "offset_y": 16
          }
        },
        {
          "vks": [
            {
              "vk": 65,
              "modifiers": [
                "ctrl"
              ]
            }
          ]
        },
        {
          "text": "MACHINE\\SOFTWARE\\zzStudioBravo"
        },
        {
          "vks": [
            {
              "vk": 13,
              "modifiers": []
            }
          ]
        }
      ],
      "delay_ms": 30,
      "label": "combo click + ctrl+a + path + ENTER (one invocation)"
    },
    {
      "action": "shot",
      "name": "r4-bravo-after-type"
    },
    {
      "action": "wait_foreground",
      "profile_action": "interact_dialog_control",
      "title_regex": "Database Security",
      "timeout_ms": 30000
    },
    {
      "action": "keys",
