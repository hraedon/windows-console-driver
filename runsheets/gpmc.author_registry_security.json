            }
          ]
        }
      ],
      "delay_ms": 600,
      "label": "Alt+A -> DOWN -> ENTER (Add Key)"
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_property_dialog",
      "title_regex": "Select Registry Key",
      "timeout_ms": 30000
    },
    {
      "action": "dump",
      "label": "select dialog after combo click"
    },
    {
      "action": "shot",
      "name": "r4-charlie-select-dialog"
    },
    {
      "action": "keys",
      "profile_action": "interact_dialog_control",
      "steps": [
        {
          "click_element": {
            "name_regex": "^(Selected key:|Folder:)",
            "offset_x": 0,
            "offset_y": 16
          }
        },
        {
          "vks": [
            {
              "vk": 65,
              "modifiers": [
                "ctrl"
              ]
            }
          ]
        },
        {
          "text": "MACHINE\\SOFTWARE\\zzStudioCharlie"
        },
        {
          "vks": [
            {
              "vk": 13,
              "modifiers": []
            }
          ]
        }
      ],
      "delay_ms": 30,
      "label": "combo click + ctrl+a + path + ENTER (one invocation)"
    },
    {
      "action": "shot",
      "name": "r4-charlie-after-type"
    },
    {
      "action": "wait_foreground",
      "profile_action": "interact_dialog_control",
      "title_regex": "Database Security",
      "timeout_ms": 30000
    },
    {
      "action": "keys",
      "profile_action": "interact_dialog_control",
      "steps": [
        {
          "vks": [
            {
              "vk": 13,
              "modifiers": []
            }
          ]
        }
      ],
      "delay_ms": 300,
      "label": "ENTER = OK on ACL (default ACL kept)",
      "settle_ms": 2000
    },
    {
      "action": "wait_foreground",
      "profile_action": "ok_security_entry_dialog",
      "title_regex": "Add Object",
      "timeout_ms": 30000
    },
    {
      "action": "click_element",
      "profile_action": "interact_dialog_control",
      "name_regex": "^Do not allow permissions on this key to be replaced$"
    },
    {
      "action": "click_element",
      "profile_action": "ok_security_entry_dialog",
      "name_regex": "^OK$",
      "settle_ms": 2000
    },
    {
      "action": "key",
      "profile_action": "close_editor_window",
      "vks": [
        {
          "vk": 115,
          "modifiers": [
            "alt"
          ]
        }
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_backup",
      "args": [
        "{args.gpo_name}",
        "C:\\gpo-studio\\manual\\r04-secsettings\\backup"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_remove",
      "args": [
        "{args.gpo_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPME"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "zz_requery"
    }
  ]
}
