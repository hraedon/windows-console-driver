{
  "name": "gpmc.author_admin_template_user",
  "surface": "gpmc-server2025",
  "steps": [
    {
      "action": "guest",
      "phase": "setup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpo_create",
      "args": [
        "{args.gpo_name}",
        "R5: version packing, user-side-only edit"
      ],
      "output_as": "setup.gpo"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpme_launch",
      "args": [
        "{out.setup.gpo.guid}",
        "{args.domain_dns}"
      ]
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_gpo_editor",
      "title_regex": "Group Policy",
      "timeout_ms": 90000
    },
    {
      "action": "context",
      "profile_action": "navigate_tree",
      "assert_window_regex": "Group Policy"
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^User Configuration$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Policies$",
      "control_type": "ListItem",
      "double": true,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Administrative Templates",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Desktop$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "open_property_dialog",
      "name_regex": "Hide Network Locations icon on desktop",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_property_dialog",
      "title_regex": "Hide Network Locations",
      "timeout_ms": 30000
    },
    {
      "action": "shot",
      "name": "r5u-before-enabled"
    },
    {
      "action": "click_element",
      "profile_action": "interact_dialog_control",
      "name_regex": "^Enabled$",
      "index": 0
    },
    {
      "action": "shot",
      "name": "r5u-after-enabled"
    },
    {
      "action": "click_element",
      "profile_action": "ok_policy_setting_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "key",
      "profile_action": "close_editor_window",
      "vks": [
        {
          "vk": 115,
          "modifiers": [
            "alt"
          ]
        }
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_backup",
      "args": [
        "{args.gpo_name}",
        "C:\\gpo-studio\\manual\\r05-multicse\\backup"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_remove",
      "args": [
        "{args.gpo_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPME"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "zz_requery"
    }
  ]
}
