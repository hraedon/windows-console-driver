{
  "name": "gpmc.author_scripts_entry",
  "surface": "gpmc-server2025",
  "steps": [
    {
      "action": "guest",
      "phase": "setup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpo_create",
      "args": [
        "{args.gpo_name}",
        "R2 re-run through the wcd engine"
      ],
      "output_as": "setup.gpo"
    },
    {
      "action": "guest",
      "phase": "setup",
      "script": "gpme_launch",
      "args": [
        "{out.setup.gpo.guid}",
        "{args.domain_dns}"
      ]
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_gpo_editor",
      "title_regex": "Group Policy",
      "timeout_ms": 90000
    },
    {
      "action": "context",
      "profile_action": "navigate_tree",
      "assert_window_regex": "Group Policy"
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Computer Configuration$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Policies$",
      "control_type": "ListItem",
      "double": true,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "^Windows Settings$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "navigate_tree",
      "name_regex": "Scripts \\(Startup/Shutdown\\)",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "open_startup_scripts_dialog",
      "name_regex": "^Startup$",
      "control_type": "ListItem",
      "double": true,
      "settle_ms": 2000
    },
    {
      "action": "wait_foreground",
      "profile_action": "open_startup_scripts_dialog",
      "title_regex": "Startup Properties",
      "timeout_ms": 30000
    },
    {
      "action": "click_element",
      "profile_action": "open_startup_scripts_dialog",
      "name_regex": "^Scripts$",
      "index": 0,
      "soft": true,
      "settle_ms": 2000
    },
    {
      "action": "click_element",
      "profile_action": "add_script_entry",
      "name_regex": "^Add",
      "index": 0
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_script_entry",
      "title_regex": "Add a Script",
      "timeout_ms": 20000
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.script1_name}"
    },
    {
      "action": "key",
      "profile_action": "add_script_entry",
      "vks": [
        {
          "vk": 9,
          "modifiers": []
        }
      ]
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.script1_params}"
    },
    {
      "action": "click_element",
      "profile_action": "ok_child_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "click_element",
      "profile_action": "add_script_entry",
      "name_regex": "^Add",
      "index": 0
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_script_entry",
      "title_regex": "Add a Script",
      "timeout_ms": 20000
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.script2_name}"
    },
    {
      "action": "click_element",
      "profile_action": "ok_child_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "key",
      "profile_action": "set_ps_order",
      "vks": [
        {
          "vk": 9,
          "modifiers": [
            "ctrl"
          ]
        }
      ]
    },
    {
      "action": "click_element",
      "profile_action": "add_script_entry",
      "name_regex": "^Add",
      "index": 0
    },
    {
      "action": "wait_foreground",
      "profile_action": "add_script_entry",
      "title_regex": "Add a Script",
      "timeout_ms": 20000
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.ps1_name}"
    },
    {
      "action": "key",
      "profile_action": "add_script_entry",
      "vks": [
        {
          "vk": 9,
          "modifiers": []
        }
      ]
    },
    {
      "action": "type_text",
      "profile_action": "add_script_entry",
      "text": "{args.ps1_params}"
    },
    {
      "action": "click_element",
      "profile_action": "ok_child_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "click_element",
      "profile_action": "ok_startup_scripts_dialog",
      "name_regex": "^OK$"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "mmc_kill"
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "gpo_remove",
      "args": [
        "{args.gpo_name}"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "task_unregister",
      "args": [
        "WCDLaunchGPME"
      ]
    },
    {
      "action": "guest",
      "phase": "cleanup",
      "script": "zz_requery"
    }
  ]
}
